# ============================================================
# 校园自习室智能预约与座位调度系统
# ============================================================

# ---------- 构建产物 ----------
target/
build/
out/
*.jar
*.war
!.mvn/wrapper/maven-wrapper.jar
*.class

# ---------- IDE：IntelliJ IDEA ----------
# 项目级的 IDEA 配置（compiler.xml / encodings.xml / jarRepositories.xml /
# misc.xml / vcs.xml）保留在版本库中，其余均为本机本地配置，不入库。
.idea/workspace.xml
.idea/usage.statistics.xml
.idea/tasks.xml
.idea/shelf/
.idea/*.iml
*.iml

# 数据库连接信息（含账号密码等本机环境数据，严禁提交）
.idea/dataSources.xml
.idea/dataSources.local.xml
.idea/dataSources/
.idea/data_source_mapping.xml
.idea/db-forest-config.xml

# 个人代码检查规则
.idea/inspectionProfiles/
.idea/dictionaries/
.idea/httpRequests/
.idea/markdown.xml
.idea/runConfigurations/

# ---------- IDE：VS Code / Eclipse ----------
.vscode/
.classpath
.project
.settings/
.factorypath
bin/

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini
*~

# ---------- 日志与临时文件 ----------
*.log
logs/
*.tmp
*.bak
*.swp
